{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "The AI Underground",
    "version":  "0.1.0",
    "identifier":  "studio.ai-underground.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev -- --host 127.0.0.1 --port 1420",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "The AI Underground",
                                    "width":  1440,
                                    "height":  920,
                                    "minWidth":  1180,
                                    "minHeight":  760
                                }
                            ],
                "security":  {
                                 "csp":  "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/icon.ico",
                                "icons/icon.png"
                            ]
               }
}
